{
  "name": "placitum-lsp",
  "version": "0.1.0",
  "description": "Language server for Placitum — static analysis only, never executes code.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "placitum-lsp": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "editors",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check-deps": "node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "ci": "npm run check-deps && npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "placitum": "github:quesadx/pl-lg#dd1f362b35888d8a19b2215772db2389e8bb244a",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "8.57.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
