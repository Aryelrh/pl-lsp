{
  "name": "placitum-lsp",
  "version": "0.1.0",
  "description": "Language server for Placitum — static analysis only, never executes code.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "lsp",
    "language-server",
    "placitum",
    "capabilities",
    "static-analysis"
  ],
  "homepage": "https://github.com/Aryelrh/pl-lsp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryelrh/pl-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/Aryelrh/pl-lsp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "placitum-lsp": "dist/bin.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "editors",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AUTHORS"
  ],
  "scripts": {
    "prepublishOnly": "npm run verify",
    "check-deps": "node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "test": "vitest run",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "verify": "npm run check-deps && npm run typecheck && npm run lint && npm run build && npm run test",
    "ci": "npm run verify && npm run smoke:pack"
  },
  "dependencies": {
    "placitum": "^1.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "8.57.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
